# Names only. Put real values in .env, which is gitignored.
# A judge uses their own keys and their own local Zetaris.
# From Docker, point Zetaris at the host: http://host.docker.internal:8888/api/v1.0
# Meterless H-MEM and World Model run in-process from vendor/. There is no Meterless key.
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
NEMOTRON_MODEL=
MODEL_ROUTE=direct
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=
NIGHTSHIFT_MODE=meterless/auto
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
SAMPLE_MODE=false
PORT=8000

# Optional: a key used only for the Planner model call. Empty means the Planner shares MODEL_API_KEY.
PLANNER_API_KEY=

# Optional: a second key used only for the Evaluator model calls. Empty means the Evaluator shares MODEL_API_KEY.
EVALUATOR_API_KEY=

# Optional second inference host for a diagnostic run (MODEL_ROUTE=paid). The NVIDIA settings above stay as they are, so MODEL_ROUTE=direct is the rollback.
PAID_BASE_URL=
PAID_MODEL=
PAID_API_KEY=
